# ============================================
# ZED Chatbot — Environment Variables
# ============================================
# Copy this file and rename it to: .env
# Never commit .env to GitHub!
# ============================================

# Get free key from: https://console.groq.com
# For POC: use Groq free tier (good enough)
# For production: Ministry will provide official LLM API key
GROQ_API_KEY= dddd

# App settings
APP_ENV=development       # change to "production" on Render
PORT=8000

# WhatsApp Meta Cloud API
META_WHATSAPP_TOKEN=njs
META_PHONE_NUMBER_ID=dd
META_WEBHOOK_VERIFY_TOKEN=dd
